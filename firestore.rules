rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOrganizer() {
      return isSignedIn() && (
        request.auth.token.email == 'abmrifat4501x@gmail.com' ||
        request.auth.token.email == 'organizer@drmcitclub.org' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organizer')
      );
    }

    // Diagnostic Connection Test endpoint
    match /test/{testId} {
      allow read: if true;
      allow write: if true;
    }

    // Host Organization Configuration
    match /organization/{orgId} {
      allow read: if true;
      allow write: if isValidId(orgId);
    }

    // Festivals Collection - Publicly readable, modifiable with valid ID
    match /festivals/{festivalId} {
      allow read: if true;
      allow create: if isValidId(festivalId);
      allow update: if isValidId(festivalId);
      allow delete: if isValidId(festivalId);
    }

    // Events Collection - Publicly readable across all devices, modifiable with valid ID
    match /events/{eventId} {
      allow read: if true;
      allow create: if isValidId(eventId);
      allow update: if isValidId(eventId);
      allow delete: if isValidId(eventId);
    }

    // Registrations Collection - Cross-device participant passes & roster verification
    match /registrations/{registrationId} {
      allow read: if true;
      allow create: if isValidId(registrationId) &&
        incoming().fullName is string && incoming().fullName.size() <= 150 &&
        incoming().email is string && incoming().email.size() <= 150;
      allow update: if isValidId(registrationId);
      allow delete: if isValidId(registrationId);
    }

    // Check-In Logs Collection
    match /checkIns/{checkInId} {
      allow read: if true;
      allow create: if isValidId(checkInId);
      allow update: if isValidId(checkInId);
      allow delete: if isValidId(checkInId);
    }

    // User Profiles Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidId(userId);
      allow update: if isValidId(userId);
      allow delete: if isValidId(userId);
    }
  }
}
